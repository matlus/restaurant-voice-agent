UV_CACHE_DIR=.uv-cache
PYTHONPATH=packages/voice-agent-restaurant/src;apps/voice-agent-web/src
# Restaurant store: a local SQLite file, created and seeded on first use. Delete it to start over.
VOICE_AGENT_RESTAURANT_DATABASE_PATH=data/restaurant.sqlite3
# Optional. true seeds a new store with the demo bookings the test scenarios use; it defaults to false.
VOICE_AGENT_RESTAURANT_SEED_DEMO_BOOKINGS=true

# Speech provider: the OpenAI Realtime API. Put your real key only in .env, never here.
OPENAI_API_KEY=
# Optional. Defaults to gpt-realtime-2.1; gpt-realtime-2.1-mini costs less.
VOICE_AGENT_OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Optional. Leave unset to use OpenAI's own address; tests point it at a scripted Realtime service on this machine.
VOICE_AGENT_OPENAI_REALTIME_WEBSOCKET_BASE_URL=
