UV_CACHE_DIR=.uv-cache
# No PYTHONPATH is needed: uv sync installs all three packages into .venv, which VS Code and pytest use.
# Restaurant store: a local SQLite file, created and seeded on first use. Delete it to start over.
VOICE_AGENT_RESTAURANT_DATABASE_PATH=data/restaurant.sqlite3
# Optional. restaurant_and_demo_bookings seeds a new store with the demo bookings the test scenarios use;
# it defaults to restaurant_only.
VOICE_AGENT_RESTAURANT_STORE_SEEDING=restaurant_and_demo_bookings

# Speech provider: the OpenAI Realtime API. Put your real key only in .env, never here.
OPENAI_API_KEY=
# Optional. Defaults to gpt-realtime-2.1; gpt-realtime-2.1-mini costs less.
VOICE_AGENT_OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Optional. Leave unset to use OpenAI's own address; tests point it at a scripted Realtime service on this machine.
VOICE_AGENT_OPENAI_REALTIME_WEBSOCKET_BASE_URL=

# Optional call limits. Every open call holds a paid Realtime session; these are the defaults.
VOICE_AGENT_MAXIMUM_CALL_SECONDS=900
VOICE_AGENT_MAXIMUM_SILENCE_SECONDS=120
VOICE_AGENT_FAREWELL_GRACE_SECONDS=15
VOICE_AGENT_MAXIMUM_CONCURRENT_CALLS=10
# Optional. Comma-separated origins of other sites whose pages may open a call; the app's own page is always allowed.
VOICE_AGENT_WEB_ALLOWED_ORIGINS=
